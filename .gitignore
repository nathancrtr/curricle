.venv/
__pycache__/
*.pyc
.DS_Store

# Editable-install metadata. Note that `build/` itself is NOT ignored: the
# compiled manifests and rendered pages there are committed artifacts.
*.egg-info/

# The personal layer. `local/` holds the profile seed and the API key; the
# rendered learner profile is a projection of one person's evidence ledger and
# is never an artifact of this repository (build/example-profile-SKILL.md is
# the committed illustration instead).
local/
build/learner-profile-SKILL.md

# Agent worktrees. Both spellings: Claude Code has used each, and an
# unignored one stages an entire nested checkout on `git add -A`.
.claude-worktrees/
.claude/worktrees/

# The README quickstart renders the example course's pages beside the course,
# because their links are relative to it — the hub reaches curriculum.md, the
# widget and the quiz reach ../../theme.css. Those outputs are a reader's
# scratch copy, not artifacts: the committed inspection copies live in build/.
examples/*/learning/index.html
examples/*/learning/curriculum.html
examples/*/learning/learning-resources.html
examples/*/learning/theme.css

# `python -m curricle faces --out build/wizard` renders every onboarding
# screen for review — a hundred-odd files that are regenerated in a second
# from synthetic state. A reviewer's scratch, not an artifact: the committed
# inspection copies in build/ are the course pages, which are few and stable.
build/wizard/
